#include <windows.h>
#include "resource.h"

IDI_APP ICON "../assets/icon.ico"

IDD_MAIN DIALOGEX 0, 0, 330, 202
STYLE DS_SETFONT | DS_CENTER | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "StayAliveMC"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Keep Minecraft running when minimized", -1, 16, 14, 298, 14
    LTEXT "For the UWP edition of Minecraft for Windows.", -1, 16, 33, 298, 12
    LTEXT "Ready. Click Enable to prevent automatic suspension.", IDC_STATUS, 16, 54, 298, 48, SS_NOPREFIX
    CONTROL "Apply automatically at Windows sign-in", IDC_STARTUP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 16, 109, 298, 15
    LTEXT "Keep StayAliveMC running while you play. Minimize to the tray.\nExit restores normal suspension; startup is a separate setting.", -1, 16, 132, 298, 27
    DEFPUSHBUTTON "Enable", IDC_ENABLE, 16, 173, 90, 17
    PUSHBUTTON "Restore default", IDC_RESTORE, 112, 173, 106, 17
    PUSHBUTTON "Exit", IDCANCEL, 224, 173, 90, 17
END

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Keep Minecraft UWP running when minimized"
            VALUE "FileVersion", "2.0.0"
            VALUE "InternalName", "StayAliveMC"
            VALUE "LegalCopyright", "Copyright (c) 2026 Riyo"
            VALUE "OriginalFilename", "StayAliveMC.exe"
            VALUE "ProductName", "StayAliveMC"
            VALUE "ProductVersion", "2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
